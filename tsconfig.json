{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "intelligent-scissors": ["./src/index.ts"],
      "intelligent-scissors/canvas": ["./src/canvas/index.ts"]
    }
  },
  "include": ["src", "test", "demo", "examples", "vite.config.ts", "tsup.config.ts"]
}
